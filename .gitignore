# ============================================================================
# Application user-data folders (DO NOT COMMIT)
# ============================================================================
# These folders live next to the app on the user's machine and contain
# user-specific data, copyrighted reference data, and large model files.
# They must NEVER be committed to the repository.

# Experimental spectra (Plot Builder)
SAMPLES/

# Raw spectra to preprocess (Match Search)
Raw_Spectrum/

# RRUFF reference database (CC-BY, separate distribution)
DATABASE_RRUFF/

# Trained PyTorch checkpoints (large files, separate archive)
MODELS/
*.pth
*.pt
*.ckpt

# Saved projects
PROJETS/

# Exports (figures, CSV, PDF reports)
SAUVEGARDE/

# ============================================================================
# Application config & generated files (DO NOT COMMIT)
# ============================================================================
# User config (contains user profile, paths, last opened files, language)
.raman_plot_builder.cfg
*.cfg

# Project files (generated by users)
*.rpm
*.rms

# Cache files (RRUFF peak detection cache)
*.pic_cache.json

# Logs
*.log
logs/

# Output figures (generated)
output/
exports/
*.pdf.tmp
_tmp_*.png

# ============================================================================
